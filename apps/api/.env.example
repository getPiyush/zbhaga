# zBhaga API Configuration Example
# Copy to .env and fill in actual values

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database
# Leave empty for PGlite (embedded, no installation needed)
# Or set to postgres://user:pass@localhost/zbhaga for a real PostgreSQL
DATABASE_URL=pglite://.pgdata

# Authentication & Security
JWT_SECRET=dev-secret-change-in-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Rate Limiting
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# CORS - Origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
PUBLIC_APP_URL=http://localhost:8081
PUBLIC_API_URL=http://localhost:4000

# OAuth Providers (all optional)
# Leave empty to disable a provider

# Google OAuth 2.0
# Setup: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth 2.0
# Setup: https://portal.azure.com/
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Okta OAuth 2.0
# Setup: https://developer.okta.com/
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DOMAIN=

# Authentication Control
# Set to 'true' to disable all authentication (not recommended for production)
# When disabled, requests don't need bearer tokens
AUTH_DISABLED=false
